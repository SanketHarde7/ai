# Slip 8 | Q1 (10 Marks)
# Create a suitable dataset containing information about earthquakes using Latitude, Longitude, Depth, and Magnitude. Perform the following tasks:\na. Create a Geospatial Visualization to display the locations of earthquakes on a map.\nb. Use color to represent the magnitude of each earthquake.


import pandas as pd
import matplotlib.pyplot as plt
df = pd.DataFrame({'Latitude': [19.1, 20.2, 21.3, 18.4, 22.5, 17.8, 23.1, 16.5], 'Longitude': [73.0, 74.1, 75.2, 76.3, 77.4, 72.6, 78.2, 74.8], 'Depth': [10, 20, 15, 30, 12, 18, 25, 14], 'Magnitude': [2.5, 4.0, 3.1, 5.2, 2.8, 3.5, 4.6, 2.9]})
plt.scatter(df['Longitude'], df['Latitude'], c=df['Magnitude'], s=df['Magnitude'] * 30)
plt.colorbar(label='Magnitude')
plt.title('Earthquake Locations')
plt.xlabel('Longitude')
plt.ylabel('Latitude')
plt.show()

