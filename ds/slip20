# Slip 20 | Q1 (10 Marks)
# Write a Python program to create a DataFrame containing the attributes Age, Salary, Experience, Working_Hours, and Performance_Score. Apply the Standardization data transformation technique and display the transformed data.

import pandas as pd
from sklearn.preprocessing import StandardScaler
df = pd.DataFrame({'Age': [20, 25, 30, 35], 'Salary': [20000, 30000, 40000, 50000], 'Experience': [1, 3, 5, 7], 'Working_Hours': [35, 40, 45, 50], 'Performance_Score': [60, 70, 80, 90]})
X = df[['Age', 'Salary', 'Experience', 'Working_Hours', 'Performance_Score']]
sc = StandardScaler()
df[['Age', 'Salary', 'Experience', 'Working_Hours', 'Performance_Score']] = sc.fit_transform(X)
print(df)

Q2:
# Slip 20 | Q2 (20 Marks)
# Create a dataset containing information about different books with the attributes Book Title, Author, Publication Year, Average Rating, and Number of Ratings.
# Perform the following tasks on created dataset:
# a. Create a Venn Diagram comparing the authors of books published in two different time periods.
# b. Generate a Word Cloud using the book titles.

import pandas as pd
import matplotlib.pyplot as plt
from matplotlib_venn import venn2
from wordcloud import WordCloud
df = pd.DataFrame({'Book_Title': ['River Road', 'Silent Sky', 'Python Basics', 'Data Science', 'Moonlight', 'AI Future'], 'Author': ['Asha', 'Ravi', 'Neha', 'Asha', 'Ravi', 'Om'], 'Publication_Year': [1995, 1998, 2005, 2010, 2001, 2020], 'Average_Rating': [4.1, 4.3, 4.5, 4.0, 4.2, 4.7], 'Number_of_Ratings': [100, 150, 200, 170, 130, 220]})
authors1 = set(df[df['Publication_Year'] < 2000]['Author'])
authors2 = set(df[df['Publication_Year'] >= 2000]['Author'])
venn2([authors1, authors2], set_labels=('Before 2000', '2000 and later'))
plt.title('Authors by Publication Period')
plt.show()
text = ' '.join(df['Book_Title'])
wordcloud = WordCloud(width=800, height=400, background_color='white').generate(text)
plt.imshow(wordcloud)
plt.title('Book Title Word Cloud')
plt.axis('off')
plt.show()
