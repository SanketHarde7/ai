# Slip 20 | Q1 (10 Marks)
# Write a Python program to create a DataFrame containing the attributes Age, Salary, Experience, Working_Hours, and Performance_Score. Apply the Standardization data transformation technique and display the transformed data.

import pandas as pd
from sklearn.preprocessing import StandardScaler
df = pd.DataFrame({'Age': [20, 25, 30, 35, 22, 27, 32, 40], 'Salary': [20000, 30000, 40000, 50000, 25000, 35000, 45000, 60000], 'Experience': [1, 3, 5, 7, 2, 4, 6, 10], 'Working_Hours': [35, 40, 45, 50, 38, 42, 46, 55], 'Performance_Score': [60, 70, 80, 90, 65, 75, 85, 95]})
X = df[['Age', 'Salary', 'Experience', 'Working_Hours', 'Performance_Score']]
sc = StandardScaler()
df[['Age', 'Salary', 'Experience', 'Working_Hours', 'Performance_Score']] = sc.fit_transform(X)
print(df)

Q2:
# Slip 20 | Q2 (20 Marks)
# Apply the Apriori algorithm to the following student activity dataset to identify frequent itemsets and generate association rules among the activities. Repeat the analysis using minimum support values 0.2 and 0.3.
# TID Items
# 1 Library, Seminar
# 2 Workshop, Project
# 3 Library, Assignment
# 4 Seminar, Workshop
# 5 Assignment, Seminar
# 6 Workshop, Assignment
# 7 Project, Library
# 8 Library, Seminar, Project
# 9 Library, Seminar, Workshop

import pandas as pd
from mlxtend.preprocessing import TransactionEncoder
from mlxtend.frequent_patterns import apriori, association_rules
transactions = [['Library', 'Seminar'], ['Workshop', 'Project'], ['Library', 'Assignment'], ['Seminar', 'Workshop'], ['Assignment', 'Seminar'], ['Workshop', 'Assignment'], ['Project', 'Library'], ['Library', 'Seminar', 'Project'], ['Library', 'Seminar', 'Workshop']]
te = TransactionEncoder()
te_array = te.fit(transactions).transform(transactions)
df = pd.DataFrame(te_array, columns=te.columns_)
print(df.isnull().sum())
df = df.fillna(False)
itemsets = apriori(df, min_support=0.2, use_colnames=True)
print(itemsets)
rules = association_rules(itemsets, metric='confidence', min_threshold=0.5)
print(rules)
itemsets = apriori(df, min_support=0.3, use_colnames=True)
print(itemsets)
rules = association_rules(itemsets, metric='confidence', min_threshold=0.5)
print(rules)
