# Write a Python program to create a DataFrame using weather.csv containing values of Temperature, Humidity, Rainfall, and Wind Speed. Generate a Heat Map to visualize the correlation between these weather parameters.

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
df = pd.read_csv('weather.csv')
# check columns with print(df.columns)
print(df.isnull().sum())
df = df.dropna()
sns.heatmap(df[['Temperature', 'Humidity', 'Rainfall', 'Wind Speed']].corr(numeric_only=True), annot=True)
plt.title('Weather Parameter Correlation')
plt.show()

