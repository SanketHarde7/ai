# Slip 14 | Q2 (20 Marks)
# Create two DataFrames containing information about different mobile phones.
# DataFrame 1: Brand, Model, Price, RAM
# DataFrame 2: Model, Storage, Battery_Capacity, Operating_System
# 
# Perform the following data transformation techniques:
# a) Data Integration by combining the two DataFrames using Model
# b) Label Encoding on the Brand attribute of the merged DataFrame
# c) One-Hot Encoding on the Operating_System attribute of the merged DataFrame
# 
# Display the original DataFrames, merged DataFrame, and transformed DataFrame.


import pandas as pd
from sklearn.preprocessing import LabelEncoder
a = pd.DataFrame({'Brand': ['A', 'B', 'C', 'A', 'B', 'C', 'A', 'B'], 'Model': ['M1', 'M2', 'M3', 'M4', 'M5', 'M6', 'M7', 'M8'], 'Price': [10000, 15000, 20000, 12000, 18000, 22000, 14000, 19000], 'RAM': [4, 6, 8, 4, 8, 12, 6, 8]})
b = pd.DataFrame({'Model': ['M1', 'M2', 'M3', 'M4', 'M5', 'M6', 'M7', 'M8'], 'Storage': [64, 128, 256, 64, 128, 256, 128, 512], 'Battery_Capacity': [4000, 4500, 5000, 4200, 4800, 5100, 4300, 5200], 'Operating_System': ['Android', 'iOS', 'Android', 'Android', 'iOS', 'Android', 'Android', 'iOS']})
print(a)
print(b)
df = pd.merge(a, b, on='Model')
print(df)
le = LabelEncoder()
df['Brand'] = le.fit_transform(df['Brand'])
df = pd.get_dummies(df, columns=['Operating_System'])
print(df)
