# Slip 2 | Q2 (20 Marks)
# Apply Linear Regression on a YouTube Video dataset to predict video views using relevant video attributes. Visualize the relationship between the predictor and target variable using a scatter plot and regression line.


import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
df = pd.read_csv('USvideos.csv')
# check columns with print(df.columns)
df = df.dropna()
X = df[['likes']]
y = df['views']
model = LinearRegression()
model.fit(X, y)
plt.scatter(X, y)
plt.plot(X, model.predict(X), color='red')
plt.title('Likes vs Video Views')
plt.xlabel('Likes')
plt.ylabel('Views')
plt.show()
