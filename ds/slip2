# Write a Python program to create an age_records DataFrame containing the attributes Person_ID and Age for suitable sample records. Perform Data Discretization on the Age attribute using Equal Width Binning. Display the original and discretized data.

import pandas as pd
df = pd.DataFrame({'Person_ID': [1, 2, 3, 4, 5], 'Age': [18, 25, 32, 45, 60]})
print(df)
df['Age_Group'] = pd.cut(df['Age'], bins=3, labels=['Low', 'Medium', 'High'])
print(df)

