# Slip 18 | Q1 (10 Marks)
# Write a Python program to create an employee_data DataFrame with the attributes: Emp_ID, Age, Dept, Years_Experience, and Performance_Rating. Perform data cleaning by handling missing values, remove duplicate records and detecting outliers using the IQR method.


import pandas as pd
df = pd.DataFrame({'Emp_ID': [1, 2, 3, 3, 5, 6, 7, 8], 'Age': [25, None, 32, 32, 28, 45, None, 50], 'Dept': ['IT', 'HR', 'HR', 'HR', 'Sales', 'IT', None, 'Sales'], 'Years_Experience': [2, 5, 7, 7, 3, 10, 8, 45], 'Performance_Rating': [3, 4, 4, 4, 3, 5, 4, 5]})
print(df.isnull().sum())
df['Age'] = df['Age'].fillna(df['Age'].median())
df['Dept'] = df['Dept'].fillna(df['Dept'].mode()[0])
df = df.drop_duplicates()
q1 = df['Years_Experience'].quantile(0.25)
q3 = df['Years_Experience'].quantile(0.75)
iqr = q3 - q1
print(df[(df['Years_Experience'] < q1 - 1.5 * iqr) | (df['Years_Experience'] > q3 + 1.5 * iqr)])
print(df)

