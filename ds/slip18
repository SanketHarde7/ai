# Slip 18 | Q2 (20 Marks)
# Use Crop Yield dataset to apply Simple Linear Regression for predicting crop yield from rainfall. Handle missing values, split the data into training and testing sets, and evaluate the model using MAE and R² Score. Create a Scatter Plot with a Regression Line to visualize the relationship.


import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, r2_score
df = pd.read_csv('crop_yield_data.csv')
# check columns with print(df.columns)
print(df.isnull().sum())
df = df.dropna()
X = df[['rainfall']]
y = df['yield']
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=1)
model = LinearRegression()
model.fit(X_train, y_train)
y_pred = model.predict(X_test)
print('MAE:', mean_absolute_error(y_test, y_pred))
print('R2:', r2_score(y_test, y_pred))
plt.scatter(X, y)
plt.plot(X, model.predict(X), color='red')
plt.title('Rainfall vs Crop Yield')
plt.xlabel('Rainfall')
plt.ylabel('Crop Yield')
plt.show()
