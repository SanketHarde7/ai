# Slip 1 | Q2 (20 Marks)
# Using the built-in Iris dataset, apply K-Means clustering with K = 3. Plot the datapoints, visualize the clusters with different colors, and display the cluster centroids.


import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
df = load_iris(as_frame=True).frame.head(10)
X = df[['sepal length (cm)', 'petal length (cm)']]
sc = StandardScaler()
X_scaled = sc.fit_transform(X)
model = KMeans(n_clusters=3, random_state=1, n_init=10)
df['Cluster'] = model.fit_predict(X_scaled)
centers = sc.inverse_transform(model.cluster_centers_)
plt.scatter(df['sepal length (cm)'], df['petal length (cm)'], c=df['Cluster'])
plt.scatter(centers[:, 0], centers[:, 1], color='red', marker='X', s=200)
plt.title('Iris K-Means Clusters')
plt.xlabel('Sepal Length')
plt.ylabel('Petal Length')
plt.show()
