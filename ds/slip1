# Slip 1 | Q1 (10 Marks)
# Create a dataframe containing information about different products such as Price, Rating, and Number of Sales. Generate a Dendrogram to group similar products based on their characteristics.


import pandas as pd
import matplotlib.pyplot as plt
from scipy.cluster.hierarchy import linkage, dendrogram
df = pd.DataFrame({'Product': ['P1', 'P2', 'P3', 'P4', 'P5', 'P6', 'P7', 'P8'], 'Price': [100, 120, 130, 300, 320, 310, 150, 160], 'Rating': [4.2, 4.0, 4.1, 4.8, 4.7, 4.6, 3.9, 4.0], 'Number_of_Sales': [50, 45, 48, 80, 75, 78, 30, 35]})
Z = linkage(df[['Price', 'Rating', 'Number_of_Sales']], method='ward')
dendrogram(Z, labels=df['Product'].tolist())
plt.title('Product Dendrogram')
plt.xlabel('Products')
plt.ylabel('Distance')
plt.show()

