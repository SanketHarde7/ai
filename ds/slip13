# A retail store has recorded the daily sales for two months. Create a dataframe using sales.csv file and generate a Box Plot to identify any outliers. Customize the graph with title and labels.

import pandas as pd
import matplotlib.pyplot as plt
df = pd.read_csv('sales.csv')
# check columns with print(df.columns)
df.plot(kind='box')
plt.title('Daily Sales Outliers')
plt.xlabel('Sales Data')
plt.ylabel('Sales')
plt.show()

