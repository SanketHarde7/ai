# Slip 13 | Q2 (20 Marks)
# Implement the K-Nearest Neighbors (KNN) algorithm to classify the Wine dataset. Perform the required data preprocessing, model training, and testing, and evaluate the model performance using Accuracy, Precision, Recall, and F1-Score.

import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
df = pd.read_csv('Wine.csv')
# check columns with print(df.columns)
print(df.isnull().sum())
df = df.dropna()
X = pd.get_dummies(df.drop('Wine', axis=1))
y = df['Wine']
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=1, stratify=y)
sc = StandardScaler()
X_train = sc.fit_transform(X_train)
X_test = sc.transform(X_test)
model = KNeighborsClassifier(n_neighbors=5)
model.fit(X_train, y_train)
y_pred = model.predict(X_test)
print('Accuracy:', accuracy_score(y_test, y_pred))
print(classification_report(y_test, y_pred))
print(confusion_matrix(y_test, y_pred))
