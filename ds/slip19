# Slip 19 | Q2 (20 Marks)
# Write a Python program to create a DataFrame with the attributes Temperature, Humidity, Wind Speed, Pressure, and Rainfall. Apply the following data transformation techniques and display the transformed data:\na) Min-Max Scaling\nb) Standardization\nc) Normalization


import pandas as pd
from sklearn.preprocessing import MinMaxScaler, StandardScaler, Normalizer
df = pd.DataFrame({'Temperature': [20, 25, 30, 35, 22, 28, 32, 38], 'Humidity': [40, 50, 60, 70, 45, 55, 65, 75], 'Wind Speed': [5, 10, 15, 20, 7, 12, 17, 22], 'Pressure': [1000, 1010, 1020, 1030, 1005, 1015, 1025, 1035], 'Rainfall': [0, 5, 10, 15, 2, 7, 12, 18]})
X = df[['Temperature', 'Humidity', 'Wind Speed', 'Pressure', 'Rainfall']]
mm = MinMaxScaler()
print(pd.DataFrame(mm.fit_transform(X), columns=X.columns))
sc = StandardScaler()
print(pd.DataFrame(sc.fit_transform(X), columns=X.columns))
norm = Normalizer()
print(pd.DataFrame(norm.fit_transform(X), columns=X.columns))
