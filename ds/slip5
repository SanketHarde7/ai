# Write a Python program to create a customer_DataFrame with suitable attributes such as Customer_ID, Gender, City, and Membership_Type. Perform label encoding technique on appropriate categorical attributes. Display the DataFrame before and after encoding.

import pandas as pd
from sklearn.preprocessing import LabelEncoder
df = pd.DataFrame({'Customer_ID': [1, 2, 3, 4], 'Gender': ['Male', 'Female', 'Male', 'Female'], 'City': ['Pune', 'Mumbai', 'Nashik', 'Pune'], 'Membership_Type': ['Gold', 'Silver', 'Gold', 'Bronze']})
print(df)
le = LabelEncoder()
df['Gender'] = le.fit_transform(df['Gender'])
df['City'] = le.fit_transform(df['City'])
df['Membership_Type'] = le.fit_transform(df['Membership_Type'])
print(df)

