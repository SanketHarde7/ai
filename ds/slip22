# Write a Python program to create a DataFrame containing the attributes City, House_Type, House_Area, Number_of_Rooms, and Monthly_Rent. Apply the Normalization technique to the numerical attributes and display the normalized data.

import pandas as pd
from sklearn.preprocessing import Normalizer
df = pd.DataFrame({'City': ['Pune', 'Mumbai', 'Nashik', 'Loni'], 'House_Type': ['Flat', 'Flat', 'Bungalow', 'Flat'], 'House_Area': [800, 900, 1500, 700], 'Number_of_Rooms': [2, 3, 4, 2], 'Monthly_Rent': [12000, 18000, 25000, 10000]})
X = df[['House_Area', 'Number_of_Rooms', 'Monthly_Rent']]
sc = Normalizer()
df[['House_Area', 'Number_of_Rooms', 'Monthly_Rent']] = sc.fit_transform(X)
print(df)

