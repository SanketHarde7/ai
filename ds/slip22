# Slip 22 | Q2 (20 Marks)
# Generate a DataFrame containing customer information for Netflix and Amazon Prime users. Create a Venn diagram and a Pie chart to show the customers using only Netflix, only Amazon Prime, and both services. Add appropriate labels, colors, and titles to both visualizations.

import pandas as pd
import matplotlib.pyplot as plt
from matplotlib_venn import venn2
df = pd.DataFrame({'Customer_ID': ['C1', 'C2', 'C3', 'C4', 'C5', 'C6'], 'Netflix': [1,1,1,0,0,0], 'Amazon_Prime': [0,0,1,1,1,0]})
netflix = set(df[df['Netflix'] == 1]['Customer_ID'])
amazon = set(df[df['Amazon_Prime'] == 1]['Customer_ID'])
venn2([netflix, amazon], set_labels=('Netflix', 'Amazon Prime'))
plt.title('Netflix and Amazon Prime Customers')
plt.show()
values = [len(netflix - amazon), len(amazon - netflix), len(netflix & amazon)]
plt.pie(values, labels=['Only Netflix', 'Only Amazon Prime', 'Both'], autopct='%1.1f%%')
plt.title('Streaming Service Customers')
plt.show()
