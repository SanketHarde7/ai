# Slip 22 | Q2 (20 Marks)
# Apply the K-Means Clustering algorithm to a student dataset containing Attendance and Marks. Perform the necessary data preprocessing, use K = 3 to group the students into three clusters, and visualize the resulting clusters along with their cluster centroids using a scatter plot.


import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
df = pd.DataFrame({'Attendance': [55, 60, 65, 70, 75, 80, 90, 95], 'Marks': [40, 45, 55, 60, 65, 75, 85, 95]})
X = df[['Attendance', 'Marks']]
sc = StandardScaler()
X_scaled = sc.fit_transform(X)
model = KMeans(n_clusters=3, random_state=1, n_init=10)
df['Cluster'] = model.fit_predict(X_scaled)
centers = sc.inverse_transform(model.cluster_centers_)
plt.scatter(df['Attendance'], df['Marks'], c=df['Cluster'])
plt.scatter(centers[:, 0], centers[:, 1], color='red', marker='X', s=200)
plt.title('Student Clusters')
plt.xlabel('Attendance')
plt.ylabel('Marks')
plt.show()
