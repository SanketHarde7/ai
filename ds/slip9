# Slip 9 | Q1 (10 Marks)
# Write a Python program to create a product DataFrame with the attributes Product_ID, Price, Quantity_Sold, Discount, and Revenue. Apply Min-Max Scaling data transformation techniques on the DataFrame and display the transformed data.


import pandas as pd
from sklearn.preprocessing import MinMaxScaler
df = pd.DataFrame({'Product_ID': [1, 2, 3, 4, 5, 6, 7, 8], 'Price': [100, 200, 300, 400, 150, 250, 350, 450], 'Quantity_Sold': [5, 10, 15, 20, 8, 12, 17, 22], 'Discount': [5, 10, 15, 20, 8, 12, 7, 18], 'Revenue': [475, 1800, 3825, 7200, 1104, 2640, 5533, 8100]})
X = df[['Price', 'Quantity_Sold', 'Discount', 'Revenue']]
sc = MinMaxScaler()
df[['Price', 'Quantity_Sold', 'Discount', 'Revenue']] = sc.fit_transform(X)
print(df)

