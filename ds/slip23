# Slip 23 | Q1 (10 Marks)
# Create a DataFrame containing information about different products with attributes such as Product_name, Price, Rating, and Number_of_Sales. Generate a Dendrogram to identify groups of similar products. Display a suitable title and labels for the Dendrogram.

import pandas as pd
import matplotlib.pyplot as plt
from scipy.cluster.hierarchy import linkage, dendrogram
df = pd.DataFrame({'Product_name': ['A', 'B', 'C', 'D', 'E'], 'Price': [100, 120, 300, 320, 150], 'Rating': [4.2, 4.0, 4.8, 4.7, 3.9], 'Number_of_Sales': [50, 45, 80, 75, 30]})
Z = linkage(df[['Price', 'Rating', 'Number_of_Sales']], method='ward')
dendrogram(Z, labels=df['Product_name'].tolist())
plt.title('Product Dendrogram')
plt.xlabel('Products')
plt.ylabel('Distance')
plt.show()

