# Slip 24 | Q2 (20 Marks)
# Consider the Car Price Prediction dataset and apply Polynomial Regression to predict the Selling Price based on Vehicle Age, Present Price, and Kilometers Driven. Perform the necessary data preprocessing, train and test the model, evaluate its performance using the R² Score, and visualize the actual data points along with the fitted polynomial regression curve.


import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score
df = pd.read_csv('car data.csv')
# check columns with print(df.columns)
print(df.isnull().sum())
df = df.dropna()
df['Vehicle_Age'] = 2026 - df['Year']
X = df[['Vehicle_Age', 'Present_Price', 'Kms_Driven']]
y = df['Selling_Price']
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=1)
poly = PolynomialFeatures(degree=2)
X_train_poly = poly.fit_transform(X_train)
X_test_poly = poly.transform(X_test)
model = LinearRegression()
model.fit(X_train_poly, y_train)
y_pred = model.predict(X_test_poly)
print('R2:', r2_score(y_test, y_pred))
plot_df = X_test.copy()
plot_df['Actual'] = y_test
plot_df['Predicted'] = y_pred
plot_df = plot_df.sort_values('Present_Price')
plt.scatter(plot_df['Present_Price'], plot_df['Actual'])
plt.plot(plot_df['Present_Price'], plot_df['Predicted'], color='red')
plt.title('Car Price Polynomial Regression')
plt.xlabel('Present Price')
plt.ylabel('Selling Price')
plt.show()
