# Slip 15 | Q1 (10 Marks)
# Write a Python program to create an age_records DataFrame containing the attributes Person_ID and Age for suitable sample records. Perform Data Discretization on the Age attribute using Equal Frequency Binning. Display the original and discretized data.


import pandas as pd
df = pd.DataFrame({'Person_ID': [1, 2, 3, 4, 5, 6, 7, 8, 9], 'Age': [18, 22, 25, 27, 31, 35, 40, 48, 55]})
print(df)
df['Age_Group'] = pd.qcut(df['Age'], q=3, labels=['Low', 'Medium', 'High'])
print(df)

Q2:
# Slip 15 | Q2 (20 Marks)
# Write a Python program to perform market basket analysis on the Groceries dataset using the Apriori algorithm. Read and explore the dataset, preprocess the data by handling missing values, convert categorical transaction data into a suitable numeric format, and generate frequent itemsets and association rules. Repeat the analysis using minimum support values 0.3 and 0.4.


import pandas as pd
from mlxtend.preprocessing import TransactionEncoder
from mlxtend.frequent_patterns import apriori, association_rules
transactions = [['Rice', 'Dal', 'Oil'], ['Atta', 'Sugar', 'Tea'], ['Rice', 'Salt', 'Oil'], ['Wheat', 'Dal', 'Spices'], ['Poha', 'Peanuts', 'Oil'], ['Rice', 'Paneer', 'Tomatoes'], ['Atta', 'Potatoes', 'Oil'], ['Rice', 'Oil', 'Salt']]
te = TransactionEncoder()
te_array = te.fit(transactions).transform(transactions)
df = pd.DataFrame(te_array, columns=te.columns_)
print(df.isnull().sum())
df = df.fillna(False)
itemsets = apriori(df, min_support=0.3, use_colnames=True)
print(itemsets)
rules = association_rules(itemsets, metric='confidence', min_threshold=0.5)
print(rules)
itemsets = apriori(df, min_support=0.4, use_colnames=True)
print(itemsets)
rules = association_rules(itemsets, metric='confidence', min_threshold=0.5)
print(rules)
