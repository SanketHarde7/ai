# Slip 6 | Q1 (10 Marks)
# Create a DataFrame containing the car model, engine size (in litres), and fuel efficiency (in km/L) for the given cars. Create a scatter plot to visualize the relationship between engine size and fuel efficiency. Add an appropriate title, label both axes, and use different colors for the data points.


import pandas as pd
import matplotlib.pyplot as plt
df = pd.DataFrame({'Car_Model': ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'], 'Engine_Size': [1.0, 1.2, 1.5, 2.0, 2.5, 1.4, 1.8, 2.2], 'Fuel_Efficiency': [22, 20, 18, 15, 12, 21, 17, 14]})
plt.scatter(df['Engine_Size'], df['Fuel_Efficiency'], c=['red', 'blue', 'green', 'orange', 'purple', 'brown', 'pink', 'gray'])
plt.title('Engine Size vs Fuel Efficiency')
plt.xlabel('Engine Size (litres)')
plt.ylabel('Fuel Efficiency (km/L)')
plt.show()

