# Slip 4 | Q1 (10 Marks)
# A survey was conducted to determine the preferred payment method among customers as shown below:
# payment_methods = ["UPI", "Credit Card", "Debit Card", "Cash", "Net Banking"]
# customers = [150, 80, 60, 40, 30]
# Create a Pie Chart to represent the percentage of customers using each payment method. Display the percentage contribution of each category and add an appropriate title.


import pandas as pd
import matplotlib.pyplot as plt
df = pd.DataFrame({'Payment_Method': ['UPI', 'Credit Card', 'Debit Card', 'Cash', 'Net Banking'], 'Customers': [150, 80, 60, 40, 30]})
plt.pie(df['Customers'], labels=df['Payment_Method'], autopct='%1.1f%%', colors=['red', 'blue', 'green', 'orange', 'purple'])
plt.title('Preferred Payment Methods')
plt.show()

