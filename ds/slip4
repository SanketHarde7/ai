# Slip 4 | Q2 (20 Marks)
# Apply the K-Means Clustering algorithm on the given E-commerce Customer dataset. Read the dataset using Python, inspect and preprocess the data by handling missing values and selecting suitable numerical features. Apply K-Means clustering to segment the customers into different categories and interpret the resulting clusters.


import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
df = pd.read_csv('Ecommerce Customers.csv')
# check columns with print(df.columns)
print(df.isnull().sum())
df = df.dropna()
X = df[['Annual Income (k$)', 'Spending Score (1-100)']]
sc = StandardScaler()
X_scaled = sc.fit_transform(X)
model = KMeans(n_clusters=3, random_state=1, n_init=10)
df['Cluster'] = model.fit_predict(X_scaled)
centers = sc.inverse_transform(model.cluster_centers_)
plt.scatter(df['Annual Income (k$)'], df['Spending Score (1-100)'], c=df['Cluster'])
plt.scatter(centers[:, 0], centers[:, 1], color='red', marker='X', s=200)
plt.title('E-Commerce Customer Clusters')
plt.xlabel('Annual Income')
plt.ylabel('Spending Score')
plt.show()
